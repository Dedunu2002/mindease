# Cell 8 — Test prediction with sample student data

def predict_risk(sleep, study, social, anxiety, stress, depression, burnout):
    """Test the model with sample values"""
    sample = np.array([[sleep, study, social, anxiety, stress, depression, burnout]])
    prediction_num = model.predict(sample)[0]
    prediction_label = le.inverse_transform([prediction_num])[0]
    probabilities = model.predict_proba(sample)[0]

    print(f"Inputs : Sleep={sleep}h, Study={study}h, Social={social}/5,"
          f" Anxiety={anxiety}/10, Stress={stress}/10,"
          f" Depression={depression}/10, Burnout={burnout}/100")
    print(f"Result : {prediction_label}")
    for label, prob in zip(le.classes_, probabilities):
        print(f"  {label}: {prob * 100:.1f}% confidence")
    print()

# ── Test 1: Healthy student ────────────────────────────────────
print("--- Test 1: Healthy student ---")
predict_risk(
    sleep=8,       # good sleep
    study=4,       # reasonable study hours
    social=4,      # good social support
    anxiety=2,     # low anxiety
    stress=2,      # low stress
    depression=1, # low depression
    burnout=15    # low burnout
)

# ── Test 2: Stressed student ──────────────────────────────────
print("--- Test 2: Stressed student ---")
predict_risk(
    sleep=4,       # poor sleep
    study=12,      # over-studying
    social=1,      # poor social support
    anxiety=8,     # high anxiety
    stress=9,      # high stress
    depression=7, # high depression
    burnout=80    # high burnout
)

# ── Test 3: Moderate student ──────────────────────────────────
print("--- Test 3: Moderate student ---")
predict_risk(
    sleep=6,
    study=7,
    social=3,
    anxiety=5,
    stress=5,
    depression=4,
    burnout=45
)


