# Cell 3 — Clean and prepare data

# Drop rows with missing values
df_clean = df.dropna()
print(f"Rows after dropping nulls: {len(df_clean)}")

# ── Select input features (X) ─────────────────────────────────
# These 7 columns match your MindEase check-in form questions
features = [
    'sleep_hours',
    'study_hours_per_day',
    'social_support',
    'anxiety_score',
    'stress_level',
    'depression_score',
    'burnout_score'
]

# ── Target column (y) ─────────────────────────────────────────
target = 'risk_level'

# Check all feature columns exist
for col in features:
    if col not in df_clean.columns:
        print(f"⚠ Column not found: {col}")
    else:
        print(f"✅ Found: {col}")

X = df_clean[features]
y = df_clean[target]

print(f"\nX shape: {X.shape}")
print(f"y shape: {y.shape}")
print(f"\nTarget classes: {y.unique()}")


# Cell 4 — Encode labels and split into train/test

# ── Encode target labels to numbers ───────────────────────────
# Good → 0, Moderate → 1, Poor → 2  (or similar)
le = LabelEncoder()
y_encoded = le.fit_transform(y)

print("Label encoding mapping:")
for i, label in enumerate(le.classes_):
    print(f"  {label} → {i}")

# ── Split: 80% training, 20% testing ──────────────────────────
X_train, X_test, y_train, y_test = train_test_split(
    X, y_encoded,
    test_size=0.2,
    random_state=42,
    stratify=y_encoded   # ensures equal class distribution in both sets
)

print(f"\nTraining samples : {len(X_train)}")
print(f"Testing  samples : {len(X_test)}")

# Check class balance in training set
unique, counts = np.unique(y_train, return_counts=True)
print("\nClass distribution in training set:")
for u, c in zip(le.classes_, counts):
    print(f"  {u}: {c} samples")


# Cell 5 — Train the Random Forest Classifier

# ── Build and train the model ──────────────────────────────────
model = RandomForestClassifier(
    n_estimators=200,      # 200 decision trees — more = more accurate
    max_depth=15,          # prevents overfitting
    min_samples_split=5,   # minimum samples to split a node
    min_samples_leaf=2,    # minimum samples in a leaf
    random_state=42,       # for reproducibility
    n_jobs=-1              # use all CPU cores for faster training
)

print("Training Random Forest... please wait")
model.fit(X_train, y_train)
print("✅ Model training complete!")

# ── Quick accuracy check ───────────────────────────────────────
train_acc = model.score(X_train, y_train)
test_acc  = model.score(X_test,  y_test)

print(f"\nTraining accuracy : {train_acc * 100:.2f}%")
print(f"Test accuracy     : {test_acc  * 100:.2f}%")

# ── Cross-validation (more reliable accuracy estimate) ────────
cv_scores = cross_val_score(model, X, y_encoded, cv=5, scoring='accuracy')
print(f"\n5-Fold Cross-validation scores: {cv_scores}")
print(f"Mean CV accuracy: {cv_scores.mean() * 100:.2f}% ± {cv_scores.std() * 100:.2f}%")


# Cell 6 — Full evaluation for your final report

y_pred = model.predict(X_test)

# ── Classification report ─────────────────────────────────────
print("=" * 55)
print("       CLASSIFICATION REPORT — AI MODEL 1")
print("=" * 55)
print(classification_report(
    y_test, y_pred,
    target_names=le.classes_
))

# ── Confusion matrix ──────────────────────────────────────────
cm = confusion_matrix(y_test, y_pred)

fig, ax = plt.subplots(figsize=(7, 5))
disp = ConfusionMatrixDisplay(
    confusion_matrix=cm,
    display_labels=le.classes_
)
disp.plot(ax=ax, colormap='Greens', cmap='Greens')
ax.set_title('Confusion Matrix — MindEase AI Model 1 (Risk Classifier)',
             fontsize=13, pad=12)
plt.tight_layout()
plt.savefig('confusion_matrix_model1.png', dpi=150, bbox_inches='tight')
plt.show()
print("✅ Confusion matrix saved as confusion_matrix_model1.png")

# ── Feature importance chart ──────────────────────────────────
importances = model.feature_importances_
feat_df = pd.DataFrame({
    'Feature':    features,
    'Importance': importances
}).sort_values('Importance', ascending=False)

fig2, ax2 = plt.subplots(figsize=(8, 4))
ax2.barh(feat_df['Feature'], feat_df['Importance'], color='#1A7A5E')
ax2.set_xlabel('Importance Score')
ax2.set_title('Feature Importance — Which inputs affect risk prediction most?')
ax2.invert_yaxis()
plt.tight_layout()
plt.savefig('feature_importance_model1.png', dpi=150, bbox_inches='tight')
plt.show()
print("✅ Feature importance chart saved")


