# Cell 2 — Load and explore dataset

# Find the exact CSV filename in the dataset
dataset_path = '/kaggle/input/datasets/sharmajicoder/student-mental-health-and-burnout/'
files = os.listdir(dataset_path)
print("Files in dataset:", files)

# Load the CSV (update filename if different)
df = pd.read_csv(dataset_path + files[0])

# Explore the data
print("\n--- Dataset Shape ---")
print(df.shape)

