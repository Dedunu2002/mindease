# ── Load each split ───────────────────────────────────────────
# The dataset has 3 files: train.txt, test.txt, val.txt
# Each line format is:  text;emotion_label

def load_emotion_file(filepath):
    texts, labels = [], []
    with open(filepath, 'r', encoding='utf-8') as f:
        for line in f:
            line = line.strip()
            if ';' in line:
                parts = line.split(';')
                texts.append(parts[0].strip())
                labels.append(parts[1].strip())
    return pd.DataFrame({'text': texts, 'emotion': labels})

# Load training data
df_train = load_emotion_file(dataset_path + 'train.txt')
df_test  = load_emotion_file(dataset_path + 'test.txt')
df_val   = load_emotion_file(dataset_path + 'val.txt')

# Combine all splits for training our model
df_all = pd.concat([df_train, df_test, df_val], ignore_index=True)

print(f"\nTrain rows : {len(df_train)}")
print(f"Test rows  : {len(df_test)}")
